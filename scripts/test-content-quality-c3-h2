# Add one separate partially-invalidated ready revision after the original H2
# correction receipt is complete. This fixture proves future admission without
# changing the immutable primary-attempt correction campaign.
cd "$repo_root"
DEEPTUTOR_HOME="$runtime_root" "$python_bin" - \
  "$fixture_json" <<'PY'
import json
from pathlib import Path
import sys

from deeptutor.courses.content_quality_repository import CourseContentQualityRepository
from deeptutor.courses.content_quality_service import CourseContentQualityService
from deeptutor.courses.practice_repository import CoursePracticeRepository
from deeptutor.courses.practice_service import CoursePracticeService
from deeptutor.courses.repository import CourseRepository
from deeptutor.multi_user.paths import get_personal_path_service

fixture_path = Path(sys.argv[1])
fixture = json.loads(fixture_path.read_text(encoding="utf-8"))
paths = get_personal_path_service(fixture["owner_identity"])
courses = CourseRepository(paths.get_courses_db(), fixture["owner_identity"])
practice = CoursePracticeService(CoursePracticeRepository(courses))
quality = CourseContentQualityService(CourseContentQualityRepository(courses))
course = courses.get_course(fixture["course_id"])
title = "Partial invalidation admission fixture"
practice_set = practice.create_practice_set(
    course.id,
    title=title,
    expected_course_write_epoch=course.write_epoch,
)
revision = practice.create_draft_revision(
    course.id,
    practice_set.id,
    expected_course_write_epoch=course.write_epoch,
)
invalidated_prompt = "Which fixture question was withdrawn?"
valid_prompt = "Which fixture question remains trustworthy?"
invalidated = practice.add_question(
    course.id,
    practice_set.id,
    revision.id,
    question_type="short_answer",
    prompt=invalidated_prompt,
    answer_contract={
        "kind": "bounded_short_answer_v1",
        "canonical_answer": "A",
        "accepted_normalized_answers": ["a"],
        "normalization_version": "bounded-text-normalization-v1",
    },
    objective_ids=["OBJ-H2-ADMISSION-A"],
    ordinal=1,
    expected_course_write_epoch=course.write_epoch,
)
valid = practice.add_question(
    course.id,
    practice_set.id,
    revision.id,
    question_type="short_answer",
    prompt=valid_prompt,
    answer_contract={
        "kind": "bounded_short_answer_v1",
        "canonical_answer": "B",
        "accepted_normalized_answers": ["b"],
        "normalization_version": "bounded-text-normalization-v1",
    },
    objective_ids=["OBJ-H2-ADMISSION-B"],
    ordinal=2,
    expected_course_write_epoch=course.write_epoch,
)
practice.ready_revision(
    course.id,
    practice_set.id,
    revision.id,
    expected_course_write_epoch=course.write_epoch,
)
report = quality.report_question(
    course.id,
    practice_set.id,
    revision.id,
    invalidated.id,
    reason="Hermetic partial-admission fixture",
)
resolved, evidence_ids = quality.resolve_report(
    course.id,
    report["id"],
    decision="invalidate",
    reviewer_user_id="h2_fixture_reviewer_not_human_approval",
    note="Hermetic C3-H2.1 admission fixture; not human approval",
)
assert resolved["state"] == "invalidated"
assert evidence_ids == []
fixture.update({
    "partial_practice_title": title,
    "partial_practice_set_id": practice_set.id,
    "partial_revision_id": revision.id,
    "partial_invalidated_question_id": invalidated.id,
    "partial_valid_question_id": valid.id,
    "partial_invalidated_prompt": invalidated_prompt,
    "partial_valid_prompt": valid_prompt,
})
fixture_path.write_text(
    json.dumps(fixture, indent=2, sort_keys=True) + "\n", encoding="utf-8"
)
fixture_path.chmod(0o600)
PY

